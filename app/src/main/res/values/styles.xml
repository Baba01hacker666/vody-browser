<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="VodyTheme" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="colorPrimary">@color/vody_primary</item>
        <item name="colorPrimaryVariant">@color/vody_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorAccent">@color/vody_accent</item>
        <!-- Adapts to system dark mode: light bg + dark text, or dark bg + light text.
             No hardcoded white window (that was the white-on-white bug). -->
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:statusBarColor">@color/vody_primary_dark</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>
</resources>
